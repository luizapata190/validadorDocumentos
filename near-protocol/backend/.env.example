# Copia este archivo a .env y ajusta si hace falta.
# El .gitignore de la raíz ya excluye .env (nunca subir el real).
# Todos los valores tienen un default en server.js: sin .env, el backend
# se comporta igual que antes (cuenta luinos.testnet en testnet).

# Puerto del servidor Express
PORT=3000

# Cuenta NEAR que firma las transacciones (debe existir en ~/.near-credentials)
NEAR_ACCOUNT_ID=luinos.testnet

# Red: testnet | mainnet
NEAR_NETWORK_ID=testnet

# Nodo RPC de NEAR
NEAR_NODE_URL=https://rpc.testnet.near.org

# Carpeta con las credenciales (por defecto ~/.near-credentials)
# NEAR_CREDENTIALS_DIR=/home/luinos/.near-credentials
